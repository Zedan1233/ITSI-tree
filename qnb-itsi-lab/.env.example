# Splunk ITSI target (management port, usually 8089)
SPLUNK_MGMT_URL=https://YOUR-INSTANCE:8089

# Prefer a REST token from Settings > Tokens
SPLUNK_TOKEN=
# Or a file containing only the token
SPLUNK_TOKEN_FILE=

# Password auth fallback (avoid if you have a token)
# SPLUNK_USERNAME=admin
# SPLUNK_PASSWORD=

# Optional. Leave empty for host-relative glass-table links.
# SPLUNK_WEB_URL=https://YOUR-INSTANCE

# Index used only when you choose to load sample events
TAMM_SAMPLE_INDEX=tamm_feedback
TAMM_SAMPLE_SOURCETYPE=tamm:feedback
